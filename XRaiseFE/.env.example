# =============================================================================
# XRaiseFE - Frontend Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values
# Note: In Next.js, use .env.local for local development
# =============================================================================

# NextAuth Configuration
NEXTAUTH_SECRET=changeme-use-a-strong-random-key

# Backend API URL (NEXT_PUBLIC_ prefix exposes to browser)
# This is used by the browser to make API calls
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Backend URL for server-side requests (e.g., NextAuth)
# Use Docker service name when running in Docker Compose
BACKEND_URL=http://xraisebe:8000

# Stripe Publishable Key (NEXT_PUBLIC_ prefix exposes to browser)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key

